# One — Agent Factory Environment Config
# Copy to .env and fill in your values

# Ollama server on your local network
OLLAMA_URL=http://localhost:11434

# Default model — start with 70B, upgrade to 405B when ready
DEFAULT_MODEL=one-70b

# How many verify loops before giving up (3 recommended)
MAX_VERIFY_LOOPS=3

# GitHub token for repo access via MCP
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Network gateway IP
# INTERNET_GATEWAY_IP=YOUR_GATEWAY_HOST  (optional)
